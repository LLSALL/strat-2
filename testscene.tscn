[sub_resource type="CSharpScript" id="CSharpScript_j8njj"]
script/source = "using Godot;
using System;

public partial class AttackTool : Tool
{
    [Export] public Camera3D cam { get; set; }

    public override StringName GetTitle()
    {
        return \"Attack\";
    }

    public override bool CheckConditions(Unit unit)
    {
        return true;
    }

    protected override void OnUnitChange(Reactive selectedUnit)
    {

    }

    protected override void OnSelectedChange(Reactive selectedTool)
    {
        if (_selectedTool.Value == this)
        {
            SetProcessInput(true);
        }
        else
        {
            SetProcessInput(false);
        }
    }

    protected override void OnActiveChange(Reactive activeTool)
    {

    }
    private const float RayLength = 1000.0f;

    // Current: When RMB pressed, check if there is a unit is under the cursor. 
    // If there is, call that unit's set health function. Tool does not become active.

    // TODO: Use LMB to select a unit if it is under the cursor. 
    // Have the player press a button to initiate the attack.
    // The attack should be animated, and the tool should become active for that duration.

    // Also have a GUI to manually swap between potential targets.
    // Guard against attacking self
    // Disallow targeting of friendlies.
    // Current unit should determine the amount of damage dealt.
    public override void _Input(InputEvent @event)
    {
        if (@event is InputEventMouseButton eventMouseButton && eventMouseButton.Pressed && eventMouseButton.ButtonIndex == MouseButton.Right)
        {
            var spaceState = GetWorld3D().DirectSpaceState;
            var mousePos = GetViewport().GetMousePosition();

            var origin = cam.ProjectRayOrigin(mousePos);
            var end = origin + cam.ProjectRayNormal(mousePos) * RayLength;
            var query = PhysicsRayQueryParameters3D.Create(origin, end);
            query.CollideWithAreas = true;

            var result = spaceState.IntersectRay(query);
            Node collider = (Node)result[\"collider\"]; // TODO figure out how to properly check this
            GD.Print(collider);
            GD.Print(collider.GetParent());
            Unit unit = (Unit) collider;
            if (unit is not null)
            {
                unit.Health -= 100;
            }
        }
    }
}"

[sub_resource type="CSharpScript" id="CSharpScript_mawog"]
script/source = "using Godot;
using System;
using System.Collections.Generic;

public partial class UIToolList : Node
{
	public StringName GroupName = \"ui\";
	[Export] public NodePath RoundStatePath { get; set; }
	[Export] public NodePath ToolListPath { get; set; }
	[Export] public CanvasItem Panel {get; set;}
	[Export] public BoxContainer ListContainer { get; set; }

	private Godot.Collections.Array<Tool> _globalToolList;

	private RoundState _roundState;
	private RoundPlayerState _playerState;

	private ReactiveBool _isPlayerTurn;
	private ReactiveObject<Unit> _selectedUnit;
	private ReactiveArray<Tool> _playerTools;
	private ReactiveObject<Tool> _selectedTool;
	private ReactiveLock<Tool> _activeTool;

	private Dictionary<Tool, Button> _toolButtonMap;

	public override void _EnterTree()
	{
		AddToGroup(GroupName);
	}

	public override void _Ready()
	{
		_roundState = GetNode<RoundState>(RoundStatePath);

		_playerTools = _roundState.PlayerState.Tools;
		_selectedUnit = _roundState.PlayerState.SelectedUnit;
		_selectedTool = _roundState.PlayerState.SelectedTool;
		_activeTool = _roundState.PlayerState.ActiveTool;
		_isPlayerTurn = _roundState.PlayerState.IsPlayerTurn;

		_isPlayerTurn.ReactiveChanged += OnChange;
		_playerTools.ReactiveChanged += OnChange;
		_selectedTool.ReactiveChanged += OnChange;
		_activeTool.ReactiveChanged += OnChange;

		_globalToolList = GetNode<GlobalToolList>(ToolListPath).ToolList;

		_toolButtonMap = new();
		foreach (Tool tool in _globalToolList)
		{
			Button button = new();
			button.Text = tool.GetTitle();
			button.Pressed += () =>
			{
				if (_activeTool.Value is not null) return;
				_selectedTool.Value = tool;
			};

			ListContainer.AddChild(button);
			_toolButtonMap.Add(tool, button);

			button.Hide();
		}
	}

	private void OnChange(Reactive r)
	{
		ClearList();
		if (_playerTools.Value is null) return;
		BuildList();
	}

	private void ClearList()
	{
		foreach ((var tool, var button) in _toolButtonMap)
		{
			button.Hide();
		}
	}

	private void BuildList()
	{
		if (_playerTools.Value is null) return;
		if (_isPlayerTurn.Value == false)
		{
			Panel.Hide();
			return;
		} else
		{
			Panel.Show();
		}
		foreach (Tool tool in _playerTools.Value)
		{
			Button button = _toolButtonMap[tool];
			switch (_activeTool.Value is not null, tool == _selectedTool.Value, _playerState.CanSelectTool(tool))
			{
				case (true, _, _):
				case (_, true, _):
				case (_, _, false):
					button.Show();
					button.Disabled = true;
					break;

				case (_, _, true):
					button.Show();
					button.Disabled = false;
					break;
			}
		}
	}
}
"

[sub_resource type="CSharpScript" id="CSharpScript_b56k5"]
script/source = "using Godot;
using System;

public partial class UIToolDescription : Node
{
    public StringName GroupName = \"ui\";
    [Export] public NodePath RoundStatePath { get; set; }
    [Export] public Panel DescriptionPanel { get; set; }
    [Export] public Label DescriptionLabel { get; set; }
    [Export] public Label UnitLabel { get; set; }

    private RoundState _roundState;

    private ReactiveObject<Tool> _selectedTool;
    private ReactiveObject<Unit> _selectedUnit;
    private ReactiveLock<Tool> _activeTool;

    public override void _EnterTree()
    {
        AddToGroup(GroupName);
    }

    public override void _Ready()
    {
        _roundState = GetNode<RoundState>(RoundStatePath);

        _selectedTool = _roundState.PlayerState.SelectedTool;
        _activeTool = _roundState.PlayerState.ActiveTool;
        _selectedUnit = _roundState.PlayerState.SelectedUnit;

        _roundState.PlayerState.IsPlayerTurn.ReactiveChanged += OnChange;
        _selectedTool.ReactiveChanged += OnChange;
        _activeTool.ReactiveChanged += OnChange;
        _selectedUnit.ReactiveChanged += OnChange;
    }

    private void OnChange(Reactive r)
    {
        if (_roundState.PlayerState.IsPlayerTurn.Value == false || _activeTool.Value is not null)
        {
            DescriptionPanel.Hide();
        }

        else
        {
            DescriptionPanel.Show();   
        }

        Tool tool = _selectedTool.Value;
        if (tool is not null)
        {
            DescriptionLabel.Text = tool.Description;
        }
        else
        {
            DescriptionLabel.Text = \"\";
        }

        Unit unit = _selectedUnit.Value;
        if (unit is not null)
        {
            UnitLabel.Text = unit.Name;
        }
        else
        {
            UnitLabel.Text = \"\";
        }
    }
}"

[sub_resource type="CSharpScript" id="CSharpScript_scc5w"]
script/source = "using Godot;
using System;

public partial class UIEndTurn : Node
{
    public StringName GroupName = \"ui\";
    [Export] public NodePath RoundStatePath { get; set; }
    [Export] public NodePath ToolListPath { get; set; }
    [Export] public NodePath RoundManagerPath { get; set; }
    [Export] public Button EndTurnButton { get; set; }

    private RoundState _roundState;
    private RoundManager _roundManager;

    public override void _EnterTree()
    {

    }

    public override void _Ready()
    {
        _roundState = GetNode<RoundState>(RoundStatePath);
        _roundManager = GetNode<RoundManager>(RoundManagerPath);
        EndTurnButton.Pressed += OnButtonPress;
    }


    public void OnButtonPress()
    {
        _roundManager.EndPlayerTurn();
        
    }
}
"

[sub_resource type="CSharpScript" id="CSharpScript_fy0p5"]
script/source = "using Godot;
using System;
using System.Collections.Generic;

public partial class UIUnitList : Node
{
	public StringName GroupName = \"ui\";
	[Export] public NodePath RoundStatePath { get; set; }
	[Export] public CanvasItem Panel {get; set;}
	[Export] public BoxContainer ListContainer { get; set; }

	private RoundState _roundState;

	private ReactiveArray<Unit> _units;

	private ReactiveBool _isPlayerTurn;

	private ReactiveObject<Unit> _selectedUnit;
	private ReactiveLock<Tool> _activeTool;

	private Dictionary<Unit, Button> _unitButtonMap;

	public override void _EnterTree()
	{
		AddToGroup(GroupName);
	}

	public override void _Ready()
	{
		_roundState = GetNode<RoundState>(RoundStatePath);

		_units = _roundState.PlayerState.Units;
		_selectedUnit = _roundState.PlayerState.SelectedUnit;
		_activeTool = _roundState.PlayerState.ActiveTool;
		_isPlayerTurn = _roundState.PlayerState.IsPlayerTurn;

		_isPlayerTurn.ReactiveChanged += OnActiveChange;
		_units.ReactiveChanged += OnUnitsChange;
		_selectedUnit.ReactiveChanged += OnSelectedChange;
		_activeTool.ReactiveChanged += OnActiveChange;

		_unitButtonMap = new();
	}

	private void OnUnitsChange(Reactive r)
	{
		ClearList();
		BuildList();
		UpdateButtonStates();
	}

	private void OnSelectedChange(Reactive r)
	{
		UpdateButtonStates();
	}

	private void OnActiveChange(Reactive r)
	{
		UpdateButtonStates();
	}

	private void ClearList()
	{
		_unitButtonMap = null;
		foreach (Node node in ListContainer.GetChildren())
		{
			ListContainer.RemoveChild(node);
			node.QueueFree();
		}
	}

	private void BuildList()
	{
		_unitButtonMap = new();
		foreach (Unit unit in _units.Value)
		{
			Button button = new();
			button.Text = unit.Name;
			button.Pressed += () => { _selectedUnit.Value = unit; };
			ListContainer.AddChild(button);
			_unitButtonMap.Add(unit, button);
		}
	}

	private void UpdateButtonStates()
	{
		if (_isPlayerTurn.Value == false)
		{
			Panel.Hide();
		}
		else
		{
			Panel.Show();
		}

		foreach ((Unit unit, Button button) in _unitButtonMap)
		{
			if (_activeTool.Value != null)
			{
				button.Show();
				button.Disabled = true;   
			}
			else if (_selectedUnit.Value == unit)
			{
				button.Show();
				button.Disabled = true;
			}
			else
			{
				button.Show();
				button.Disabled = false;
			}
		}
	}
}
"

[sub_resource type="CSharpScript" id="CSharpScript_hkdkl"]
script/source = "using Godot;
using System;

public partial class RoundManager : Node
{
	public StringName GroupName = \"round_manager\";
	[Export] public NodePath RoundStatePath { get; set; }

	private RoundState _roundState;

	public override void _EnterTree()
	{
		AddToGroup(GroupName);
	}

	public override void _Ready()
	{
		_roundState = GetNode<RoundState>(RoundStatePath);
	}

	public void EndPlayerTurn()
	{
		_roundState.PlayerState.EndPlayerTurn();
		_roundState.EnemyState.IsEnemyTurn.Value = true;
	}

	private void EndEnemyTurn()
	{
		_roundState.EnemyState.IsEnemyTurn.Value = false;
		_roundState.PlayerState.BeginPlayerTurn();
	}
}
"

[sub_resource type="CSharpScript" id="CSharpScript_egudy"]
script/source = "using Godot;
using System;

public partial class PlayerTurnManager : Node
{
	public StringName GroupName = \"player_turn_manager\";
	[Export] public NodePath RoundStatePath { get; set; }

	private RoundState _roundState;

	public override void _EnterTree()
	{
		AddToGroup(GroupName);
	}

	public override void _Ready()
	{
		_roundState = GetNode<RoundState>(RoundStatePath);
		_roundState.PlayerState.SelectedUnit.ReactiveChanged += OnUnitChange;
		_roundState.PlayerState.IsPlayerTurn.ReactiveChanged += OnTurnChange;
	}

	private void OnUnitChange(Reactive r)
	{
		// TODO Check for null value
		if (_roundState.PlayerState.SelectedUnit.Value is null)
		{
		_roundState.PlayerState.Tools.Value = null;
		_roundState.PlayerState.SelectedTool.Value = null;
		}
		else
		{
		_roundState.PlayerState.Tools.Value = _roundState.PlayerState.SelectedUnit.Value.Tools;
		_roundState.PlayerState.SelectedTool.Value = null;
		}
	}

	private void CheckConditions()
	{
		bool canAct = true;
		foreach (Unit unit in _roundState.PlayerState.Units.Value)
		{
			foreach (Tool tool in unit.Tools)
			{
				if (canAct = tool.CanUse(unit) == true) break;
			}
			if (canAct) break;
		}
		if (!canAct)
		{
			//Transition to enemy turn
		}
	}

	private void OnTurnChange(Reactive r)
	{
		_roundState.PlayerState.SelectedTool.Value = null;
		_roundState.PlayerState.SelectedUnit.Value = null;
	}
}
"

